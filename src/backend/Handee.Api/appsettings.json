{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=HandeeDb;Username=postgres;Password=1234",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "Handee",
    "Audience": "Web",
    "SecretKey": "change-this-jwt-secret-key-later",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "GoogleMaps": {
    "ApiKey": "YOUR_GOOGLE_MAPS_API_KEY_HERE"
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUser": "your-gmail@gmail.com",
    "SmtpPass": "your-app-password"
  },
  "Storage": {
    "UploadPath": "uploads"
  },
  "InternalApi": {
    "SharedSecret": "dev-internal-secret-change-in-prod"
  },
  "Seeding": {
    "AdminEmail": "admin@handee.lk",
    "AdminPassword": "Admin@1234!"
  }
