@handee_API_HostAddress = http://localhost:5057

# ─── Token store ─────────────────────────────────────────────────────────────
# Run "AUTH — Login (Admin)" from handee.API.auth.http first, then paste token here.
@adminToken = PASTE_ADMIN_ACCESS_TOKEN_HERE

# After creating a category (STEP 2), paste the returned id here.
@skillCategoryId = PASTE_SKILL_CATEGORY_ID_HERE

###
# ─────────────────────────────────────────────────────────────────────────────
#  STEP 1 — List all skill categories (public, no token required)
#  Expected: 200 OK — array of { id, name, iconUrl } sorted alphabetically
# ─────────────────────────────────────────────────────────────────────────────
GET {{handee_API_HostAddress}}/api/service-categories

###
# ─────────────────────────────────────────────────────────────────────────────
#  STEP 2 — Admin: create a skill category
#  Expected: 201 Created — { id, name, iconUrl }
#  Copy the returned `id` into @skillCategoryId above.
# ─────────────────────────────────────────────────────────────────────────────
POST {{handee_API_HostAddress}}/api/service-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Plumbing",
  "iconUrl": null
}

###
# ─────────────────────────────────────────────────────────────────────────────
#  STEP 3 — Admin: create another category
#  Expected: 201 Created
# ─────────────────────────────────────────────────────────────────────────────
POST {{handee_API_HostAddress}}/api/service-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Electrical",
  "iconUrl": null
}

###
# ─────────────────────────────────────────────────────────────────────────────
#  STEP 4 — Admin: duplicate name guard
#  Expected: 409 Conflict — "A skill category named 'Plumbing' already exists."
# ─────────────────────────────────────────────────────────────────────────────
POST {{handee_API_HostAddress}}/api/service-categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Plumbing",
  "iconUrl": null
}

###
# ─────────────────────────────────────────────────────────────────────────────
#  STEP 5 — Admin: rename a category + set an icon URL
#  Expected: 204 No Content; GET /api/service-categories should reflect the change
# ─────────────────────────────────────────────────────────────────────────────
PUT {{handee_API_HostAddress}}/api/service-categories/{{skillCategoryId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Plumbing & Pipe Fitting",
  "iconUrl": "https://example.com/icons/plumbing.png"
}

###
# ─────────────────────────────────────────────────────────────────────────────
#  STEP 6 — Admin: delete a category (safe — no providers assigned)
#  Expected: 204 No Content
# ─────────────────────────────────────────────────────────────────────────────
DELETE {{handee_API_HostAddress}}/api/service-categories/{{skillCategoryId}}
Authorization: Bearer {{adminToken}}

###
# ─────────────────────────────────────────────────────────────────────────────
#  STEP 7 — Admin: delete a category that still has providers
#  Expected: 409 Conflict — "Cannot delete '...' — N provider(s) still reference it."
#  (Assign the category to a provider first via PUT /api/providers/{id}, then retry)
# ─────────────────────────────────────────────────────────────────────────────
DELETE {{handee_API_HostAddress}}/api/service-categories/{{skillCategoryId}}
Authorization: Bearer {{adminToken}}

###
# ─────────────────────────────────────────────────────────────────────────────
#  STEP 8 — Admin: delete a non-existent category
#  Expected: 404 Not Found
# ─────────────────────────────────────────────────────────────────────────────
DELETE {{handee_API_HostAddress}}/api/service-categories/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{adminToken}}

###
# ─────────────────────────────────────────────────────────────────────────────
#  STEP 9 — Non-admin tries to create a category
#  Expected: 403 Forbidden
# ─────────────────────────────────────────────────────────────────────────────
POST {{handee_API_HostAddress}}/api/service-categories
Authorization: Bearer PASTE_PROVIDER_OR_CUSTOMER_TOKEN_HERE
Content-Type: application/json

{
  "name": "Should Not Be Created",
  "iconUrl": null
}

###
